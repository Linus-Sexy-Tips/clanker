# Build context exclusions for the Containerfile. Docker/BuildKit and Podman/Buildah both read .dockerignore;
# don't add a .containerignore or Containerfile.dockerignore (Podman uses only .containerignore if one exists,
# BuildKit prefers Containerfile.dockerignore), or the two builders would see different exclusions.
# Keep local data, secrets and build output out of the context.

.git
.github
node_modules
dist
coverage
test
data

# Local configs and secrets. The example config is fine to include.
**/*.toml
!clanker.example.toml
**/.env
**/.env.*
**/secrets

# SQLite ledgers and their WAL files
**/*.db
**/*.db-wal
**/*.db-shm
